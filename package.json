{
  "name": "mpfy",
  "version": "1.0.0",
  "private": true,
  "description": "MPfy: personal music player, served by phones or servers and reached over HyperDHT",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "imports": {
    "#net": {
      "bare": "bare-tcp",
      "default": "net"
    },
    "#fs": {
      "bare": "bare-fs",
      "default": "fs"
    },
    "#path": {
      "bare": "bare-path",
      "default": "path"
    }
  },
  "scripts": {
    "server": "node server/index.mjs",
    "client": "node client-node/index.mjs",
    "test": "node --test --test-concurrency=2 \"test/*.test.mjs\"",
    "test:server": "node --test --test-concurrency=2 \"test/unit-*.test.mjs\" \"test/e2e.test.mjs\"",
    "test:unit": "node --test --test-concurrency=2 \"test/unit-*.test.mjs\"",
    "test:e2e": "node --test \"test/e2e.test.mjs\""
  },
  "dependencies": {
    "b4a": "1.9.0",
    "bare-fs": "4.8.4",
    "bare-path": "3.1.3",
    "bare-tcp": "2.6.1",
    "compact-encoding": "3.7.0",
    "hypercore-crypto": "3.7.0",
    "hyperdht": "6.36.0",
    "music-metadata": "12.5.0",
    "protomux": "3.13.1",
    "sodium-native": "5.2.1",
    "streamx": "2.28.1",
    "yauzl": "3.4.0"
  }
}
