{
  "name": "mpfy-worklet",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Bare worklet of the MPfy Android app: runs client-core, which serves 127.0.0.1:47123",
  "license": "UNLICENSED",
  "scripts": {
    "pack": "bare-pack --linked --host android-arm64 --base ../.. --out ../app/src/main/assets/app.bundle index.js",
    "clean-libs": "node clean-libs.mjs ../app/src/main/jniLibs/arm64-v8a",
    "link": "bare-link --host android-arm64 --out ../app/src/main/jniLibs index.js",
    "build": "npm run pack && npm run clean-libs && npm run link"
  },
  "devDependencies": {
    "bare-link": "4.3.0",
    "bare-pack": "3.2.0"
  },
  "overrides": {
    "bare-module-lexer": "1.6.5"
  }
}
